{
  "appId": "app.volna.music",
  "productName": "Volna",
  "copyright": "Copyright © 2026 Volna",
  "directories": { "output": "desktop-dist" },
  "files": [
    "dist/**/*",
    "desktop/**/*",
    "server/**/*.mjs",
    "package.json",
    "!node_modules/@fontsource/**/*",
    "!node_modules/lucide-react/**/*",
    "!node_modules/react/**/*",
    "!node_modules/react-dom/**/*",
    "!node_modules/scheduler/**/*"
  ],
  "electronLanguages": ["ru", "en-US"],
  "asar": true,
  "compression": "maximum",
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "public/app-icon-512.png",
    "signAndEditExecutable": false,
    "artifactName": "Volna-${version}-Windows-x64.exe"
  },
  "portable": { "requestExecutionLevel": "user" }
}
